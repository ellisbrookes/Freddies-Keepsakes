<% @body_id = 'login' %>
<div id="existing-customer">
  <h1 class="admin-auth__title"><%= t('spree.admin_login') %></h1>
  <p class="admin-auth__subtitle">Sign in to manage your shop.</p>

  <div data-hook="login">
    <%= form_for Spree::User.new, as: :spree_user, url: spree.admin_create_new_session_path, html: { class: "admin-auth__form" } do |f| %>
      <div id="password-credentials">
        <div class="admin-auth__field">
          <%= f.label :email, t('spree.email') %>
          <%= f.email_field :email, class: 'form-control', tabindex: 1, autocomplete: 'username', autofocus: true, required: true %>
        </div>
        <div class="admin-auth__field">
          <%= f.label :password, t('spree.password') %>
          <%= f.password_field :password, class: 'form-control', tabindex: 2, autocomplete: 'current-password', required: true %>
        </div>
      </div>

      <div class="admin-auth__row">
        <label class="admin-auth__check">
          <%= f.check_box :remember_me, tabindex: 3 %>
          <span><%= t('spree.remember_me') %></span>
        </label>
        <%= link_to t('spree.forgot_password'), spree.admin_recover_password_path, class: "admin-auth__link" %>
      </div>

      <%= f.submit t('spree.login'), class: 'btn btn-primary admin-auth__submit', tabindex: 4 %>
    <% end %>
  </div>
</div>
<div data-hook="login_extras"></div>
