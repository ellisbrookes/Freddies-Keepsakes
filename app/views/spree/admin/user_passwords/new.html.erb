<div id="forgot-password">
  <h1 class="admin-auth__title"><%= t('spree.forgot_password') %></h1>
  <p class="admin-auth__subtitle"><%= t('spree.instructions_to_reset_password') %></p>

  <%= form_for Spree::User.new, as: :spree_user, url: spree.admin_reset_password_path, html: { class: "admin-auth__form" } do |f| %>
    <div class="admin-auth__field">
      <%= f.label :email, t('spree.email') %>
      <%= f.email_field :email, class: 'form-control', autocomplete: 'username', autofocus: true, required: true %>
    </div>

    <%= f.submit t('spree.reset_password'), class: 'btn btn-primary admin-auth__submit' %>
  <% end %>

  <p class="admin-auth__footer"><%= link_to t('spree.login'), spree.admin_login_path, class: "admin-auth__link" %></p>
</div>
