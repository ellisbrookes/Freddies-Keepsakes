<%
  # Add the shop's social profile URLs here. Icons with a blank URL are hidden.
  social_links = {
    "Instagram" => { url: "", icon: "ri-instagram-line" },
    "Facebook"  => { url: "", icon: "ri-facebook-circle-line" },
    "Pinterest" => { url: "", icon: "ri-pinterest-line" },
  }.select { |_, link| link[:url].present? }
%>

<% if social_links.any? %>
  <div class="flex justify-center items-center gap-x-6">
    <% social_links.each do |name, link| %>
      <%= link_to link[:url], target: "_blank", rel: "noopener", title: name, class: "transition-colors duration-200 hover:text-brand-gold-light" do %>
        <span class="sr-only"><%= name %></span>
        <svg class="w-6 h-6 fill-current" aria-hidden="true">
          <use xlink:href="<%= image_path('remixicon.symbol.svg') %>#<%= link[:icon] %>"></use>
        </svg>
      <% end %>
    <% end %>
  </div>
<% end %>
