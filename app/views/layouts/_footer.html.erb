<%
  footer_columns = {
    "Shop" => [
      ["Shop Home", store_path],
      ["All Products", products_path],
      ["My Account", spree_current_user ? account_path : login_path],
      ["Basket", cart_path],
    ],
    "Customer Service" => [
      ["Contact Us", contact_page_path],
      ["Delivery Information", delivery_page_path],
      ["Returns & Refunds", returns_page_path],
      ["FAQs", faqs_page_path],
    ],
    "Legal" => [
      ["Privacy Policy", privacy_policy_page_path],
      ["Terms & Conditions", terms_page_path],
      ["Cookie Policy", cookie_policy_page_path],
    ],
  }
  footer_link_class = "text-body-sm text-white/75 transition-colors duration-200 hover:text-brand-gold-light"
%>
<footer class="bg-gradient-to-tr from-brand-slate-dark via-brand-slate to-[#677582] text-white mt-16">
  <div class="wrapper">
    <div class="grid grid-cols-2 gap-x-6 gap-y-10 py-14 md:grid-cols-12 md:gap-x-8">
      <div class="col-span-2 flex flex-col items-center gap-y-6 md:col-span-4 md:items-start">
        <%= link_to root_path, title: current_store.name do %>
          <%= image_tag "logo_keepsakes.svg", alt: current_store.name, class: "w-48" %>
        <% end %>
        <p class="max-w-xs text-center text-body-sm leading-relaxed text-white/75 md:text-left">Personalised tops, jumpers, cups and lots of other lovely goodies, made with love by a one-person business.</p>
        <div class="text-white/80">
          <%= render "shared/social_icons" %>
        </div>
      </div>

      <% footer_columns.each_with_index do |(heading, links), index| %>
        <nav class="<%= index.zero? ? 'md:col-start-7' : '' %> <%= index == 2 ? 'col-span-2 sm:col-span-1' : '' %> md:col-span-2 lg:col-span-2" aria-label="<%= heading %>">
          <h2 class="mb-4 text-eyebrow uppercase font-sans-md text-brand-gold"><%= heading %></h2>
          <ul class="flex flex-col gap-y-3">
            <% links.each do |label, path| %>
              <li><%= link_to label, path, class: footer_link_class %></li>
            <% end %>
          </ul>
        </nav>
      <% end %>
    </div>

    <div class="flex flex-col items-center gap-4 border-t border-white/15 py-6 md:flex-row md:justify-between">
      <div class="flex flex-col items-center gap-1 md:items-start">
        <p class="text-body-xs text-white/60">&copy; <%= Time.current.year %> <%= current_store.name %>. All rights reserved.</p>
        <p class="text-body-xs text-white/60">Made by <%= link_to "Ellis Development", "https://ebrookes.dev", target: "_blank", rel: "noopener", class: "text-white/80 underline-offset-2 hover:text-brand-gold-light hover:underline" %></p>
      </div>
      <ul class="flex flex-wrap justify-center gap-x-5 gap-y-2">
        <li><%= link_to "Privacy", privacy_policy_page_path, class: "text-body-xs text-white/60 hover:text-white" %></li>
        <li><%= link_to "Terms", terms_page_path, class: "text-body-xs text-white/60 hover:text-white" %></li>
        <li><%= link_to "Cookies", cookie_policy_page_path, class: "text-body-xs text-white/60 hover:text-white" %></li>
      </ul>
    </div>

    <%
      available_locales = current_store.available_locales.map do |locale|
        [
          I18n.t('spree.i18n.this_file_language',
          locale: locale,
          default: locale.to_s,
          fallback: false), locale
        ]
      end.sort
    %>
    <% if available_locales.many? %>
      <div class="locale-selector"  data-controller="locale-selector">
        <%= form_tag select_locale_path do %>
          <div class="locale-selector__select-input select-input">
            <%= label_tag :switch_to_locale, "#{t('spree.i18n.language')}:" %>
            <%= select_tag(:switch_to_locale, options_for_select(available_locales, I18n.locale), data: { action: "locale-selector#submitForm", "locale-selector-target" => "selector" }) %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</footer>
