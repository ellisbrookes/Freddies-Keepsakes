<!doctype html>
<html lang="<%= I18n.locale %>">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <%= csrf_meta_tags %>
    <title><%= admin_page_title %></title>
    <%= favicon_link_tag "spree/backend/favicon.ico" %>
    <%= stylesheet_link_tag Spree::Backend::Config.theme_path(session[:admin_light_theme]), media: "(prefers-color-scheme: light)" %>
    <%= stylesheet_link_tag Spree::Backend::Config.theme_path(session[:admin_dark_theme]), media: "(prefers-color-scheme: dark)" %>
    <%= stylesheet_link_tag "admin_auth" %>
  </head>
  <body class="admin-auth">
    <main class="admin-auth__main">
      <%= link_to "/", class: "admin-auth__logo" do %>
        <%= image_tag Spree::Config.admin_interface_logo, alt: current_store&.name || "Store" %>
      <% end %>

      <div class="admin-auth__card">
        <% { error: flash[:error], alert: flash[:alert], notice: flash[:notice], success: flash[:success] }.each do |type, message| %>
          <% next if message.blank? %>
          <div class="admin-auth__flash admin-auth__flash--<%= type %>" role="<%= %i[error alert].include?(type) ? "alert" : "status" %>"><%= message %></div>
        <% end %>

        <%= yield %>
      </div>

      <%= link_to "← Back to the shop", "/", class: "admin-auth__back" %>
    </main>
  </body>
</html>
