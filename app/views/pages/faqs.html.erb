<%
  faqs = [
    {
      group: "Personalisation",
      items: [
        [ "How do I add my personalisation?",
          "On any personalised item there's a box on the product page where you type your name, date or message before adding it to your basket. You'll see it again in your basket, at checkout and in your order confirmation email." ],
        [ "How much can I write?",
          "Up to #{Personalisation::MAX_LENGTH} characters. If you need something longer or more unusual, please #{link_to('get in touch', contact_page_path)} before ordering." ],
        [ "Will you check my spelling?",
          "I'll make it exactly as you've typed it, including spelling, capital letters and punctuation, so please check it carefully before you order. If something looks unusual I may get in touch, but I can't always know what's intended." ],
        [ "I've made a mistake in my personalisation. Can I change it?",
          "Please #{link_to('get in touch', contact_page_path)} straight away with your order number. If I haven't started making your order yet, I'll happily change it." ],
        [ "Can I order the same item with different names?",
          "Yes. Add the item to your basket once for each name (typing a different name each time) and they'll appear as separate items." ],
      ],
    },
    {
      group: "Orders and delivery",
      items: [
        [ "How long will my order take?",
          "Personalised items are made to order, so they take a little longer. See #{link_to('delivery information', delivery_page_path)} for making times and delivery options." ],
        [ "Do you deliver outside the UK?",
          "Not at the moment. I only deliver to UK addresses for now." ],
        [ "Will I know when my order has been posted?",
          "Yes, you'll get an email when it's on its way, with a tracking number if you chose tracked delivery." ],
        [ "Do I need an account to order?",
          "No, you can check out as a guest. An account just makes it quicker next time and lets you see your past orders." ],
      ],
    },
    {
      group: "Returns and problems",
      items: [
        [ "Can I return a personalised item?",
          "Personalised items can't be returned just because you've changed your mind, as they're made especially for you. If it's faulty, damaged or I've made a mistake, I'll put it right. See #{link_to('returns & refunds', returns_page_path)}." ],
        [ "Can I return something that isn't personalised?",
          "Yes, within 14 days of receiving it. See #{link_to('returns & refunds', returns_page_path)} for how." ],
        [ "My order hasn't arrived or arrived damaged. What do I do?",
          "Please #{link_to('get in touch', contact_page_path)} with your order number (and a photo if it's damaged) and I'll sort it out." ],
      ],
    },
    {
      group: "Something special",
      items: [
        [ "Can you make something that isn't on the website?",
          "I love a custom request! #{link_to('Get in touch', contact_page_path)} with your idea and I'll let you know what's possible." ],
        [ "How do I look after my item?",
          fill_in_later("care instructions, e.g. washing tops inside out at 30°C, hand-washing cups") ],
      ],
    },
  ]
%>
<%= render layout: "pages/page" do %>
  <p>Can't find your answer here? Please <a href="<%= contact_page_path %>">get in touch</a>. I'm always happy to help.</p>

  <% faqs.each do |section| %>
    <h2><%= section[:group] %></h2>
    <div class="not-prose flex flex-col divide-y divide-gray-200 border-y border-gray-200 dark:divide-gray-700 dark:border-gray-700">
      <% section[:items].each do |question, answer| %>
        <details class="group py-4">
          <summary class="flex cursor-pointer items-center justify-between gap-4 font-sans-md text-body-md">
            <%= question %>
            <span class="shrink-0 text-accent-600 transition-transform group-open:rotate-45 dark:text-accent-300" aria-hidden="true">+</span>
          </summary>
          <%# Answers are written above (with link_to/fill_in_later), never customer text. %>
          <p class="mt-3 text-body leading-relaxed text-gray-700 dark:text-gray-300 [&_a]:text-accent-600 [&_a]:underline dark:[&_a]:text-accent-300"><%= sanitize(answer.to_s, tags: %w[a mark], attributes: %w[href class]) %></p>
        </details>
      <% end %>
    </div>
  <% end %>
<% end %>
