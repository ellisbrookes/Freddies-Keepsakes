<%# Brand banner at the top of every shop email (order confirmation, shipping, cancellation, refunds). %>
<table width="100%" cellpadding="0" cellspacing="0" role="presentation" style="background-color:#566475;">
  <tr>
    <td align="center" style="padding:24px 16px;text-align:center;">
      <a href="<%= main_app.root_url %>" style="text-decoration:none;">
        <%= image_tag "logo.png", alt: "Freddies Personalised Boutique", width: 180,
              style: "display:block;float:none;clear:none;margin:0 auto;width:180px;max-width:180px;height:auto;border:0;color:#D9B66A;font-family:Arial,sans-serif;font-size:18px;" %>
      </a>
    </td>
  </tr>
</table>
